    "home.m100": {
      "source": "<span>01</span><div><h3>Back up your files</h3><p>Save a copy of the files on internal storage.</p></div>",
      "source_sha256": "2004dbc0ade0334039a099fcd8330494592d21d83e72fd15c8338decf26cbd27",
      "translation": "<span>01</span><div><h3>Dateien sichern</h3><p>Sichere die Dateien aus dem internen Speicher.</p></div>"
    },
    "home.m101": {
      "source": "<span>02</span><div><h3>Install the firmware</h3><p>Copy the firmware file over USB and follow the guide to restart.</p></div>",
      "source_sha256": "cd5c04c6c126e742d50d4d5a28d83ba7fbf2e4e26f424cc2e0cc992b834a1eff",
      "translation": "<span>02</span><div><h3>Firmware installieren</h3><p>Kopiere die Firmwaredatei per USB und starte den Player wie in der Anleitung neu.</p></div>"
    },
    "home.m102": {
      "source": "<span>03</span><div><h3>Open your library</h3><p>Add music and let the player scan it.</p></div>",
      "source_sha256": "4dce86296409deb4c45747c099276a2bfc05696de6f3de0b75956aa7c214fa6f",
      "translation": "<span>03</span><div><h3>Bibliothek öffnen</h3><p>Füge Musik hinzu und lasse den Player danach suchen.</p></div>"
    },
