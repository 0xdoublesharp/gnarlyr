    "home.a013": {
      "source": "Gnarlyr Cover Flow with album artwork",
      "source_sha256": "6201d6775567c7e37a63e5e6d5b1ecc74d25ab17e80cda109ef85ba3bccd5e7e",
      "translation": "Gnarlyr Cover Flow mit Albumcovern"
