    "home.m023": {
      "source": "Cover Flow",
      "source_sha256": "99cc914a01e890352d45fec6c26bb19e33d9da8d3d40d435dedcc5f42134d91f",
      "translation": "Cover Flow"
    },
    "home.m024": {
      "source": "Flip through covers, browse an artist’s albums by year, or jump by letter in long lists. Albums without artwork get a cover with their initials.",
      "source_sha256": "383bfbf7d4333bde2551a41039554da7e0a3d31c9538519f5b8a6114ffea86c1",
      "translation": "Blättere durch Cover, stöbere nach Jahr durch die Alben eines Künstlers oder springe in langen Listen zum gewünschten Buchstaben. Alben ohne Artwork erhalten ein Cover mit ihren Initialen."
    },
    "home.m025": {
      "source": "Browse the library →",
      "source_sha256": "e23684cbfd498d37e6035ba0643cf8eaa78fb405be5387ae199f150ed18409d7",
      "translation": "Zur Musikbibliothek →"
    },
    "home.a014": {
      "source": "Gnarlyr Up Next showing an editable play order",
      "source_sha256": "2b01478cb3219b98c61eac374217cf5e8488d5ccafa1a65fcc0211d1c9e184a1",
      "translation": "Gnarlyr Als Nächstes mit bearbeitbarer Wiedergabereihenfolge"
    },
    "home.a015": {
      "source": "Gnarlyr Up Next showing an editable play order",
      "source_sha256": "2b01478cb3219b98c61eac374217cf5e8488d5ccafa1a65fcc0211d1c9e184a1",
      "translation": "Gnarlyr Als Nächstes mit bearbeitbarer Wiedergabereihenfolge"
    },
    "home.m027": {
      "source": "Up Next and mixtapes",
      "source_sha256": "1c92434b981a57026a5f69db535dcf04fdc6f7e97abc8dcfd25a68aa58aa4649",
      "translation": "Warteschlange und Mixtapes"
    },
    "home.m028": {
      "source": "Add or move songs in Up Next. Save up to 32 mixtapes, including two-sided C60 or C90 tapes you flip as you listen.",
      "source_sha256": "12760cc7dad2d614ebb5c01c5a3d0098e22869f9d5d3b384cc977a7e92fcf006",
      "translation": "Füge Titel zur Warteschlange hinzu oder verschiebe sie. Speichere bis zu 32 Mixtapes, darunter zweiseitige C60- oder C90-Kassetten, die du beim Hören umdrehst."
    },
    "home.m029": {
      "source": "Manage the queue →",
      "source_sha256": "64cb51705218e93e3518affd36c0c2feb1e8647df2031259f75496c937518501",
      "translation": "Warteschlange bearbeiten →"
    },
    "home.a016": {
      "source": "Gnarlyr Sound shaping with Warmth, Brightness, and Bass controls",
      "source_sha256": "3c2fe9e2a40cad5c835a8fdec5bffc661fd7a5e0ad321faff2ba3b8fd3ffb4f6",
      "translation": "Gnarlyr Klanggestaltung mit Reglern für Wärme, Höhen und Bass"
    },
    "home.a017": {
      "source": "Gnarlyr Sound shaping with Warmth, Brightness, and Bass controls",
      "source_sha256": "3c2fe9e2a40cad5c835a8fdec5bffc661fd7a5e0ad321faff2ba3b8fd3ffb4f6",
      "translation": "Gnarlyr Klanggestaltung mit Reglern für Wärme, Höhen und Bass"
    },
    "home.m031": {
      "source": "Equalizer",
      "source_sha256": "71255f2b68557b0515baaccd0baf1657730689a4d95229923027b83d397f6960",
      "translation": "Equalizer"
    },
    "home.m032": {
      "source": "Add warmth, bring vocals closer, or fine-tune a parametric EQ. Save your sound and keep favorite controls in Quick Settings.",
      "source_sha256": "73420e428f3904e9cb1b99bddafdb1027eb5fa64521649fa328fa40670fb433b",
      "translation": "Sorge für mehr Wärme, hole Stimmen nach vorn oder stimme einen parametrischen EQ fein ab. Speichere deinen Sound und lege deine Lieblingsregler in die Schnelleinstellungen."
    },
    "home.m033": {
      "source": "Adjust the sound →",
      "source_sha256": "f5d815af7cf290cbed1ca93254a7a41b9eea85e8b80408e9ef49ccb9a54c7e3c",
      "translation": "Klang einstellen →"
    },
    "home.m034": {
      "source": "Screens shown with a sample library.",
      "source_sha256": "bef36488fd2f43e3d06d332e056c5c0a5aa274007cc82de648a491152263de08",
      "translation": "Bildschirme mit einer Beispielbibliothek dargestellt."
    },
    "home.m036": {
      "source": "Playback and controls",
      "source_sha256": "1d4f1cc2bcedb63e92f8e2f1561bbf29333ecca5a1895d660e59576653d7f0be",
      "translation": "Wiedergabe und Bedienung"
    },
    "home.m037": {
      "source": "All features →",
      "source_sha256": "03c78285097558d18b188fb66b01724a5e5d6a078a68aa5f22b4da54f70042f9",
      "translation": "Alle Funktionen →"
    },
    "home.m038": {
      "source": "Gapless playback",
      "source_sha256": "018d983670010e57c0954d8e1b2132a807ca153080ebbb3d3c5c73c9605d93e4",
      "translation": "Nahtlose Wiedergabe"
    },
    "home.m039": {
      "source": "Gapless playback keeps compatible tracks together, from live sets to continuous mixes.",
      "source_sha256": "8c3e543760f276c0c387e4a683b3c3637a05a130001bf6ed2a4c773e44329a57",
      "translation": "Lückenlose Wiedergabe verbindet kompatible Titel – von Live-Sets bis zu durchgehenden Mixen."
    },
    "home.m040": {
      "source": "Playback →",
      "source_sha256": "9da8aa860ccd9ea5805e6cfa46d0f5a6a62c250af40e232d55935dd97d0097b9",
      "translation": "Wiedergabe →"
    },
    "home.m041": {
      "source": "Audiobooks",
      "source_sha256": "a01be1671e8272084901c592024bcb8272e2b81fc895178358d107c5de99e4cb",
      "translation": "Hörbücher"
    },
    "home.m042": {
      "source": "M4B books get their own shelf, chapter titles, and bookmarks. Slow down or listen faster, from 0.5× to 3×, without changing the pitch.",
      "source_sha256": "9f546e42d49f1ae311e1bfa0b82878cb43c285f6901115202df6f682ac872d3c",
      "translation": "M4B-Hörbücher bekommen ein eigenes Regal, Kapiteltitel und Lesezeichen. Höre langsamer oder schneller, von 0,5× bis 3×, ohne die Tonhöhe zu ändern."
    },
    "home.m043": {
      "source": "Audiobooks →",
      "source_sha256": "6ef7711c7585e791fc70f1abd05ec542565c49ab488df1d93948689d9aca1cbf",
      "translation": "Hörbücher →"
    },
    "home.m044": {
      "source": "Button shortcuts",
      "source_sha256": "bcb371225b4171d38758bfb087bb0ad24202c101ae864f312c9723f66be3a30e",
      "translation": "Tastenkürzel"
    },
    "home.m045": {
      "source": "Assign tap and hold shortcuts. Skip with Power + Volume even while locked, or control playback with the screen off.",
      "source_sha256": "abbde972c95f3f3d9989e81eb342a74c01fff17fe26a658e42fab42813eb5bf3",
      "translation": "Belege Kurzbefehle für Tippen und Halten. Überspringe Titel mit Ein/Aus + Lautstärke auch bei gesperrtem Gerät oder steuere die Wiedergabe bei ausgeschaltetem Bildschirm."
    },
    "home.m046": {
      "source": "Controls →",
      "source_sha256": "232346cb3a52e32f24b22859d91a15cc3c62bb99cd211804562731ca3cd0ff16",
      "translation": "Bedienung →"
    },
    "home.m047": {
      "source": "Display options",
      "source_sha256": "a6150b11d28c1d529624fd1f0b94892a06b3f373991b334134591c917de0600d",
      "translation": "Anzeigeoptionen"
    },
    "home.m048": {
      "source": "Change the text size or switch to portrait. On Now Playing, choose Cover, Cassette, VU meters, or Spectrum.",
      "source_sha256": "8bba71e805496b3f54f8b579cb74d123a4d210d59d59e43770b7d97609962d80",
      "translation": "Ändere die Schriftgröße oder wechsle ins Hochformat. Wähle für die Wiedergabeansicht Cover, Kassette, VU-Meter oder Spektrum."
    },
    "home.m049": {
      "source": "Personalization →",
      "source_sha256": "cb1b6a99c0fc9a6c20dafce4c39ef4bad088be41d405739eb6a326857225ea0c",
      "translation": "Personalisierung →"
    },
    "home.m068": {
      "source": "<strong>What changes from stock →</strong><span>Editable queues, saved mixes, chaptered books, and controls you can make your own.</span>",
      "source_sha256": "6c840def94fca882fe204daa6a2233abb625ff25494d760a683fe8f7361cca9b",
      "translation": "<strong>Was sich gegenüber dem Original ändert →</strong><span>Bearbeitbare Warteschlangen, gespeicherte Mixe, Hörbücher mit Kapiteln und anpassbare Bedienelemente.</span>"
    },
    "home.m069": {
      "source": "<strong>ECHO hardware and controls →</strong><span>See the audio hardware, USB power modes, brightness controls, and clock.</span>",
      "source_sha256": "1e77052ff2078a6eb6de111ee97d3a63f028faa6c219e708daed57d58f22eb9a",
      "translation": "<strong>ECHO-Hardware und Bedienung →</strong><span>Mehr zur Audiohardware, den USB-Strommodi, der Helligkeit und der Uhr.</span>"
    },
