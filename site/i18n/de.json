    "home.m009": {
      "source": "<span>Your ECHO.</span><span class=\"gnarly\">Rewound.</span>",
      "source_sha256": "d48122043035c480361d0084d12674a924304ef6e23ad6df0acfe82a9f9f10d9",
      "translation": "<span>Dein ECHO.</span><span class=\"gnarly\">Zurückgespult.</span>"
    },
    "home.m010": {
      "source": "Browse your albums by cover, rearrange the songs coming up, and save the best mixes for another listen.",
      "source_sha256": "211a5666797b7b70f697f60d6ca77b1c06e6b593cbe5129be94fa28a52b9bbb7",
      "translation": "Blättere durch deine Albumcover, ändere die Reihenfolge der nächsten Titel und speichere deine Lieblingsmixe für später."
    },
    "home.m011": {
      "source": "Install Gnarlyr <span aria-hidden=\"true\">→</span>",
      "source_sha256": "6519b0344b5a5bfef9488223248b8a85634323e174f4d32791614c3ea8a4bd38",
      "translation": "Gnarlyr installieren <span aria-hidden=\"true\">→</span>"
    },
