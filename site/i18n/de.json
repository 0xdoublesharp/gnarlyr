      "source": "Made for the <a href=\"https://www.amazon.com/dp/B0GK61Y1FD?tag=doublesharp-20\" rel=\"sponsored nofollow\">Snowsky ECHO ↗</a>.",
      "source_sha256": "7435878e48ddeb15f9fb6875c82281902ccdd3044290e88519833aead56b88dd",
      "translation": "Für den <a href=\"https://www.amazon.com/dp/B0GK61Y1FD?tag=doublesharp-20\" rel=\"sponsored nofollow\">Snowsky ECHO ↗</a>."
    },
