diff --git a/src/gfx/font.c b/src/gfx/font.c
index e9eac9e..6e6e693 100644
--- a/src/gfx/font.c
+++ b/src/gfx/font.c
@@ -30,11 +30,20 @@ static const Glyph *search(const Font *font, uint32_t codepoint)
     return NULL;
 }
 
+static uint32_t pack_face_of(const Font *font, uint32_t codepoint)
+{
+    if (codepoint < FONT_PACK_CJK_START) {
+        return font->pack_face;
+    }
+    return codepoint < FONT_PACK_CJK_SPLIT ? FONT_PACK_CJK_FACE : FONT_PACK_CJK_FACE + 1u;
+}
+
 const Glyph *font_find_glyph(const Font *font, uint32_t codepoint)
 {
     const Glyph *glyph = search(font, codepoint);
-    if (glyph == NULL && font->pack_face != 0) {
-        glyph = font_pack_find(font->pack_face - 1u, codepoint);
+    uint32_t face = pack_face_of(font, codepoint);
+    if (glyph == NULL && face != 0) {
+        glyph = font_pack_find(face - 1u, codepoint);
     }
     return glyph != NULL ? glyph : search(font, FONT_FALLBACK_CODEPOINT);
 }
