string(ASCII 35 hash)
set(ECHO_SLOT_MODULES views settings library listening equalizer playing stage format)
set(ECHO_SLOT_MODULE_NUMBERS 1 2 3 4 9 11 16 17)

function(echo_module_guard_resident_sources output)
    set(resident ${ECHO_SCREEN_MODULE_SHARED_SOURCES})
    foreach(module IN LISTS ECHO_SCREEN_MODULES)
        if(NOT module IN_LIST ECHO_SLOT_MODULES)
            list(APPEND resident ${ECHO_SCREEN_MODULE_SOURCES_${module}})
        endif()
    endforeach()
    set(${output} ${resident} PARENT_SCOPE)
endfunction()

function(echo_module_guard_masks sources_output)
    echo_module_guard_resident_sources(resident)
    set(sources "")
    foreach(module number IN ZIP_LISTS ECHO_SLOT_MODULES ECHO_SLOT_MODULE_NUMBERS)
        foreach(source IN LISTS ECHO_SCREEN_MODULE_SOURCES_${module} ECHO_SCREEN_MODULE_UI_SOURCES)
            if(source IN_LIST resident)
                continue()
            endif()
            string(MAKE_C_IDENTIFIER ${source} key)
            if(NOT DEFINED mask_${key})
                set(mask_${key} 0)
                list(APPEND sources ${source})
            endif()
            math(EXPR mask_${key} "${mask_${key}} | (1 << ${number})")
            set(mask_${key} ${mask_${key}} PARENT_SCOPE)
        endforeach()
    endforeach()
    set(${sources_output} ${sources} PARENT_SCOPE)
endfunction()

function(echo_module_guard_header directory index output)
    string(LENGTH "0${index}" width)
    if(width GREATER 2)
        set(name ${index})
    else()
        set(name 0${index})
    endif()
    set(header ${directory}/module_guard_set_${name}.h)
    file(CONFIGURE OUTPUT ${header} CONTENT "${hash}if defined(__APPLE__)
${hash}pragma clang section bss=\"__DATA,__em${name}_b\" data=\"__DATA,__em${name}_d\" rodata=\"__DATA,__em${name}_c\" relro=\"__DATA,__em${name}_r\" text=\"__TEXT,__em${name}_t,regular,pure_instructions\"
${hash}else
${hash}pragma clang section bss=\"em${name}_b\" data=\"em${name}_d\" rodata=\"em${name}_c\" relro=\"em${name}_r\" text=\"em${name}_t\"
${hash}endif
")
    set(${output} ${header} PARENT_SCOPE)
endfunction()

function(echo_module_guard_library directory owners)
    add_library(echo_module_guard STATIC ${PROJECT_SOURCE_DIR}/tests/support/module_guard.c)
    target_include_directories(echo_module_guard PUBLIC ${PROJECT_SOURCE_DIR}/tests/support
        PRIVATE ${directory})
    target_link_libraries(echo_module_guard PRIVATE echo_options)
    if(ECHO_SANITIZE OR ECHO_ADDRESS_SANITIZER)
        target_compile_definitions(echo_module_guard PRIVATE MODULE_GUARD_SANITIZER_STACK)
    endif()
    foreach(owner IN LISTS owners)
        target_link_libraries(${owner} PUBLIC echo_module_guard)
    endforeach()
endfunction()

function(echo_host_module_guard)
    if(CMAKE_CROSSCOMPILING)
        return()
    endif()
    set(directory ${CMAKE_BINARY_DIR}/module_guard)
    set(masks "")
    set(owners echo_app)
    if(CMAKE_C_COMPILER_ID MATCHES "Clang")
        echo_module_guard_masks(sources)
    else()
        set(sources "")
    endif()
    foreach(source IN LISTS sources)
        echo_screen_module_owner(${source} owner name)
        if(NOT TARGET ${owner} OR owner STREQUAL "echo_device")
            continue()
        endif()
        string(MAKE_C_IDENTIFIER ${source} key)
        list(FIND masks ${mask_${key}} index)
        if(index LESS 0)
            list(LENGTH masks index)
            list(APPEND masks ${mask_${key}})
        endif()
        echo_module_guard_header(${directory} ${index} header)
        set_property(SOURCE ${PROJECT_SOURCE_DIR}/${source} TARGET_DIRECTORY ${owner} APPEND
            PROPERTY COMPILE_OPTIONS -include ${header} -finstrument-functions-after-inlining)
        set_property(SOURCE ${PROJECT_SOURCE_DIR}/${source} TARGET_DIRECTORY ${owner} APPEND
            PROPERTY OBJECT_DEPENDS ${header})
        list(APPEND owners ${owner})
    endforeach()
    list(LENGTH masks count)
    if(count GREATER 24)
        message(FATAL_ERROR "module guard: ${count} owner sets exceed the 24 the guard declares")
    endif()
    list(JOIN masks "u, " joined)
    if(count EQUAL 0)
        set(joined "0")
    endif()
    file(CONFIGURE OUTPUT ${directory}/module_guard_sets.h CONTENT "${hash}pragma once
${hash}define MODULE_GUARD_SET_COUNT ${count}
${hash}define MODULE_GUARD_SET_MASKS {${joined}u}
")
    list(REMOVE_DUPLICATES owners)
    echo_module_guard_library(${directory} "${owners}")
endfunction()
