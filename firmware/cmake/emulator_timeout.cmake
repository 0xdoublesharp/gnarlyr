function(echo_emulator_timeout_hundredths output)
    set(scale "$ENV{ECHO_EMULATOR_TIMEOUT_SCALE}")
    if(scale STREQUAL "")
        set(scale 1)
    endif()
    if(NOT scale MATCHES "^([0-9]+)(\\.([0-9][0-9]?))?$")
        message(FATAL_ERROR
            "ECHO_EMULATOR_TIMEOUT_SCALE must be a number with at most two decimals, not '${scale}'")
    endif()
    set(fraction "${CMAKE_MATCH_3}00")
    string(SUBSTRING "${fraction}" 0 2 fraction)
    math(EXPR hundredths "${CMAKE_MATCH_1} * 100 + 1${fraction} - 100")
    if(hundredths LESS 100)
        message(FATAL_ERROR "ECHO_EMULATOR_TIMEOUT_SCALE must be at least 1, not '${scale}'")
    endif()
    set(${output} ${hundredths} PARENT_SCOPE)
endfunction()

function(echo_emulator_timeout output seconds)
    echo_emulator_timeout_hundredths(hundredths)
    math(EXPR scaled "(${seconds} * ${hundredths} + 99) / 100")
    set(${output} ${scaled} PARENT_SCOPE)
endfunction()
