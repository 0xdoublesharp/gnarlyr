{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (Debug, sanitizers)",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ECHO_SANITIZE": "ON"
      }
    },
    {
      "name": "dev-echo",
      "displayName": "Development for the full-size Echo board (480x222, simulator only)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-echo",
      "cacheVariables": {
        "ECHO_BOARD": "ECHO"
      }
    },
    {
      "name": "device",
      "displayName": "Device firmware (Cortex-M3, Release -O2)",
      "binaryDir": "${sourceDir}/build/device",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2",
        "ECHO_BUILD_SIM": "OFF",
        "ECHO_BUILD_TESTS": "OFF",
        "ECHO_BUILD_DEVICE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release firmware (device build without developer Diagnostics)",
      "inherits": "device",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "ECHO_RELEASE": "ON"
      }
    },
    {
      "name": "device-echo",
      "displayName": "Device firmware for the full-size Echo (Cortex-M3, Release -O2)",
      "inherits": "device",
      "binaryDir": "${sourceDir}/build/device-echo",
      "cacheVariables": {
        "ECHO_BOARD": "ECHO",
        "ECHO_FIRMWARE_VERSION": "0.0.1"
      }
    },
    {
      "name": "release-echo",
      "displayName": "Release firmware for the full-size Echo (device build without developer Diagnostics)",
      "inherits": "device-echo",
      "binaryDir": "${sourceDir}/build/release-echo",
      "cacheVariables": {
        "ECHO_RELEASE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-echo",
      "configurePreset": "dev-echo"
    },
    {
      "name": "device",
      "configurePreset": "device"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "device-echo",
      "configurePreset": "device-echo"
    },
    {
      "name": "release-echo",
      "configurePreset": "release-echo"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-echo",
      "configurePreset": "dev-echo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
